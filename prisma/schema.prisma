// Stage 0 schema — Auth.js required models + cron proof + settings.
// Database: PostgreSQL preferred; MySQL/MariaDB fallback pending cPanel validation.
// For MySQL, change provider to "mysql" and replace @db.Text with @db.LongText where needed.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "debian-openssl-1.1.x"]
}

// ─── Auth.js required models ──────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Extended — not part of Auth.js spec
  passwordHash String?
  role         UserRole  @default(CONSUMER)
  adminRole    AdminRole @default(NONE)
  mfaEnabled          Boolean  @default(false)
  mfaSecret           String?  // encrypted TOTP secret; null until MFA enrolled
  morningBoostEmails  Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt    DateTime @updatedAt

  username     String?  @unique

  accounts Account[]
  sessions Session[]

  groupMemberships         GroupMember[]
  groupRequests            GroupRequest[]
  reviewedRequests         GroupRequest[]            @relation("ReviewedGroupRequests")
  posts                    Post[]
  comments                 Comment[]
  reactions                Reaction[]
  conversationParticipants ConversationParticipant[]
  sentMessages             DirectMessage[]
  socialProfile            SocialProfile?
  providerProfile          ProviderProfile?
  ambassadorProfile        AmbassadorProfile?
  referredByReferral       Referral?         @relation("ReferredUser")
  rsvps                    EventRsvp[]
  giftCodesRedeemed        GiftCode[]
  loyaltyPoints            LoyaltyPoint[]
  crmContact               Contact?
  territoryAssignments     TerritoryAssignment[]
  affiliateAssignments     AffiliateAssignment[]
  pushSubscriptions        PushSubscription[]
  stripeCustomerId         String?
  membership               UserMembership?
  providerContacts         ProviderContact[]  @relation("ProviderContacts")
  providerCampaigns        ProviderCampaign[] @relation("ProviderCampaigns")
  memberFocusAreas         MemberFocusArea[]
  memberPreference         MemberPreference?

  @@index([email])
  @@index([stripeCustomerId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Cron job tracking (FN-S0-OPS-001) ───────────────────────────────────────
// cPanel calls /api/cron?job=KEY&token=CRON_SECRET
// The handler acquires a row-level lock, executes, and records outcome.

model CronJob {
  id           String        @id @default(cuid())
  key          String        @unique // e.g. "daily-digest"
  status       CronJobStatus @default(PENDING)
  lockedAt     DateTime?
  lockedBy     String? // e.g. hostname or run UUID for multi-instance safety
  startedAt    DateTime?
  finishedAt   DateTime?
  lastRunAt    DateTime?
  errorMessage String?       @db.Text
  runCount     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([key])
  @@index([status])
}

// ─── Site settings ────────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ─── Products & Pricing ───────────────────────────────────────────────────────
// Admin-configurable products (memberships, books, digital/physical goods).
// Prices are separate so one product can have multiple billing intervals.

model Product {
  id              String      @id @default(cuid())
  type            ProductType
  name            String
  slug            String      @unique
  description     String?     @db.Text
  features        String[]    // membership feature bullet list
  imageUrl        String?
  active          Boolean     @default(true)
  sortOrder       Int         @default(0)
  stripeProductId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  prices          Price[]

  @@index([type, active])
  @@index([sortOrder])
}

model Price {
  id             String        @id @default(cuid())
  productId      String
  interval       PriceInterval
  amount         Int           // in cents; 0 = free
  currency       String        @default("usd")
  trialDays      Int?          // only for FREE_TRIAL interval
  membershipRole UserRole?     // role granted on purchase (null for non-membership)
  stripePriceId  String?       @unique
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  memberships    UserMembership[]

  @@index([productId])
  @@index([active])
}

model UserMembership {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  priceId                String
  stripeSubscriptionId   String?            @unique
  stripeCustomerId       String?
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  trialEnd               DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  price Price @relation(fields: [priceId], references: [id])

  @@index([stripeSubscriptionId])
  @@index([status])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// ─── Social Profiles (Phase 2c) ──────────────────────────────────────────────

model SocialProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  headline  String?
  bio       String?  @db.Text
  location  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Provider Business Profile (Phase 3) ─────────────────────────────────────

model ProviderProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  businessName String?
  specialty   String?
  services    String?  @db.Text
  website     String?
  phone       String?
  serviceArea String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Ambassador Profile + Referral Tracking (Phase 4) ────────────────────────

model AmbassadorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  territory    String?
  bio          String?  @db.Text
  website      String?
  phone        String?
  referralCode String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[]
}

model Referral {
  id              String    @id @default(cuid())
  ambassadorId    String
  referralCode    String
  referredUserId  String?   @unique
  convertedAt     DateTime?
  createdAt       DateTime  @default(now())

  ambassador   AmbassadorProfile @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  referredUser User?             @relation("ReferredUser", fields: [referredUserId], references: [id])

  @@index([ambassadorId])
  @@index([referralCode])
}

// ─── Direct Messages (Phase 2b) ──────────────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     DirectMessage[]
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String    @db.Text
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── Social / FN Network (Phase 2a) ──────────────────────────────────────────

model SocialGroup {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?         @db.Text
  coverUrl    String?
  autoMember     Boolean         @default(false)
  autoAmbassador Boolean         @default(false)
  autoProvider   Boolean         @default(false)
  visibility     GroupVisibility @default(PUBLIC)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  members  GroupMember[]
  posts    Post[]
  requests GroupRequest[]

  @@index([visibility])
}

model GroupMember {
  id         String          @id @default(cuid())
  groupId    String
  userId     String
  role       GroupMemberRole @default(MEMBER)
  joinedAt   DateTime        @default(now())
  lastReadAt DateTime?

  group SocialGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GroupRequest {
  id         String             @id @default(cuid())
  groupId    String
  userId     String
  message    String?            @db.Text
  status     GroupRequestStatus @default(PENDING)
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime           @default(now())

  group    SocialGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?       @relation("ReviewedGroupRequests", fields: [reviewedBy], references: [id])

  @@unique([groupId, userId])
  @@index([groupId, status])
}

model Post {
  id          String    @id @default(cuid())
  groupId     String
  authorId    String
  body        String    @db.Text
  attachments Json?
  pinned      Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  group     SocialGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions Reaction[]

  @@index([groupId, createdAt])
  @@index([authorId])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  body      String    @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions Reaction[]

  @@index([postId])
}

model Reaction {
  id        String       @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
  @@index([commentId])
}

// ─── Blog (admin-managed posts) ──────────────────────────────────────────────

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?   @db.Text
  body        String    @db.Text
  category    String?
  imageUrl    String?
  authorName  String    @default("Anthony J. Placito")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
  @@index([category])
}

// ─── Morning Boost (daily member content) ────────────────────────────────────

model MorningBoost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?   @db.Text
  body        String    @db.Text
  imageUrl    String?
  authorName  String    @default("Anthony J. Placito")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
}

// ─── Resources (member-gated content library) ────────────────────────────────

model Resource {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?   @db.Text
  body        String    @db.Text
  type        String?   // "Guide", "Worksheet", "Video", "Template", "Tool"
  imageUrl    String?
  fileUrl     String?
  authorName  String    @default("Anthony J. Placito")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
  @@index([type])
}

// ─── Provider / Ambassador applications ──────────────────────────────────────

model UserApplication {
  id               String            @id @default(cuid())
  type             ApplicationType
  status           ApplicationStatus @default(DRAFT)
  name             String?
  email            String
  message          String?           @db.Text
  businessName     String?
  userId           String?
  phone            String?
  contactId        String?
  submittedAt      DateTime?
  emailVerifiedAt  DateTime?
  emailVerifyToken String?           @unique
  draftExpiresAt   DateTime?
  infoRequestNotes String?           @db.Text
  referralCode     String?
  campaignSource   String?
  assignedTo       String?
  reviewedAt              DateTime?
  reviewedBy              String?
  reviewNotes             String?           @db.Text
  previousApplicationId    String?
  expirationReminderSentAt DateTime?
  accountInviteToken       String?           @unique
  accountInviteExpiresAt   DateTime?
  accountInviteSentAt      DateTime?
  directoryListed          Boolean           @default(false)
  directoryListedAt        DateTime?
  markedSpam               Boolean           @default(false)
  markedSpamAt             DateTime?
  createdAt                DateTime          @default(now())

  providerDetail        ProviderApplicationDetail?
  ambassadorDetail      AmbassadorApplicationDetail?
  territoryAssignments  TerritoryAssignment[]
  affiliateAssignment   AffiliateAssignment?
  onboardingRecord      OnboardingRecord?
  checklistItems        ChecklistItem[]
  events                ApplicationEvent[]

  @@index([type, status])
  @@index([email])
}

model BlockedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  blockedBy String
  createdAt DateTime @default(now())

  @@index([email])
}

model ApplicationEvent {
  id            String          @id @default(cuid())
  applicationId String
  application   UserApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String
  actor         String?
  meta          Json?
  createdAt     DateTime        @default(now())

  @@index([applicationId, createdAt(sort: Desc)])
}

model ProviderApplicationDetail {
  id               String    @id @default(cuid())
  applicationId    String    @unique
  firstName        String    @default("")
  lastName         String    @default("")
  phone            String    @default("")
  businessName     String?
  businessType     String?
  yearsInBusiness  String?
  website          String?
  licenseNumber    String?
  insuranceCarrier String?
  insuranceExpiry  String?
  serviceCategory  String?
  serviceDescription String? @db.Text
  serviceAreas     String[]
  pricingModel     String?
  priceRange       String?
  whyJoining       String?   @db.Text
  targetAudience   String?   @db.Text
  differentiation  String?   @db.Text
  linkedinUrl      String?
  facebookUrl      String?
  instagramUrl     String?
  otherSocialUrl   String?
  agreedToAccuracy Boolean   @default(false)
  agreedToPolicy   Boolean   @default(false)
  agreedToContact  Boolean   @default(false)
  signatureName    String?
  agreedAt         DateTime?
  updatedAt        DateTime  @updatedAt

  application UserApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model AmbassadorApplicationDetail {
  id                   String    @id @default(cuid())
  applicationId        String    @unique
  firstName            String    @default("")
  lastName             String    @default("")
  phone                String    @default("")
  city                 String?
  state                String?
  occupation           String?
  employer             String?
  howHeardAboutFN      String?
  memberSince          String?
  audienceSize         String?
  platformsUsed        String[]
  communityDescription String?   @db.Text
  geographicFocus      String?
  whyJoining           String?   @db.Text
  missionAlignment     String?   @db.Text
  referralNetwork      String?   @db.Text
  linkedinUrl          String?
  facebookUrl          String?
  instagramUrl         String?
  tiktokUrl            String?
  youtubeUrl           String?
  podcastUrl           String?
  blogUrl              String?
  agreedToAccuracy     Boolean   @default(false)
  agreedToPolicy       Boolean   @default(false)
  agreedToContact      Boolean   @default(false)
  signatureName        String?
  agreedAt             DateTime?
  updatedAt            DateTime  @updatedAt

  application UserApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

// ─── Audit log ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String   // dot-notation: "application.approved", "user.role_changed"
  resource   String   // model name: "UserApplication", "User"
  resourceId String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ─── Admin team invites ───────────────────────────────────────────────────────

model AdminInvite {
  id          String    @id @default(cuid())
  email       String
  role        AdminRole
  token       String    @unique
  invitedById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  claimedAt   DateTime?
  claimedById String?

  @@index([email])
  @@index([token])
}

// ─── Contact form submissions ─────────────────────────────────────────────────

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

// ─── Ask The Fixer submissions ────────────────────────────────────────────────

model FixerQuestion {
  id          String         @id @default(cuid())
  name        String
  email       String
  subject     String?
  body        String         @db.Text
  status      QuestionStatus @default(NEW)
  reply       String?        @db.Text
  respondedAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([status, createdAt])
}

// ─── Events (Phase 5) ────────────────────────────────────────────────────────

model Event {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?   @db.Text
  coverUrl    String?
  location    String?
  isVirtual   Boolean   @default(false)
  meetingUrl  String?
  startsAt    DateTime
  endsAt      DateTime?
  capacity    Int?
  priceCents  Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rsvps EventRsvp[]

  @@index([startsAt])
  @@index([publishedAt])
}

model EventRsvp {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  status    RsvpStatus @default(REGISTERED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// ─── Gift Codes (Phase 5) ────────────────────────────────────────────────────

model GiftCode {
  id               String    @id @default(cuid())
  code             String    @unique
  grantedRole      UserRole  @default(MEMBER)
  description      String?
  redeemedByUserId String?
  redeemedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  redeemedBy User? @relation(fields: [redeemedByUserId], references: [id])

  @@index([code])
}

// ─── Loyalty Points (Phase 5) ────────────────────────────────────────────────

model LoyaltyPoint {
  id         String   @id @default(cuid())
  userId     String
  points     Int
  reason     String
  resourceId String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MEMBER
  CONSUMER
  PROVIDER
  AMBASSADOR
}

enum AdminRole {
  NONE
  ADMIN
  SUPER_ADMIN
}

enum CronJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum ProductType {
  MEMBERSHIP
  BOOK
  DIGITAL
  PHYSICAL
}

enum PriceInterval {
  FREE_TRIAL
  MONTHLY
  ANNUAL
  ONE_TIME
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum GroupMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum GroupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReactionType {
  LIKE
}

enum QuestionStatus {
  NEW
  IN_REVIEW
  RESPONDED
  CLOSED
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

enum ApplicationType {
  PROVIDER
  AMBASSADOR
}

enum RsvpStatus {
  REGISTERED
  CANCELLED
  WAITLISTED
}

enum ApplicationStatus {
  PENDING                    // legacy
  APPROVED                   // legacy
  REJECTED                   // legacy
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFO_REQUIRED
  RESUBMITTED
  CONDITIONALLY_ACCEPTED
  ACCEPTED_ONBOARDING_REQUIRED
  ONBOARDING_IN_PROGRESS
  TERRITORY_PENDING
  PAYMENT_PENDING
  PAYMENT_FAILED
  ACTIVE
  DECLINED
  WITHDRAWN
  EXPIRED
}

// ─── CRM (Phase CRM-1) ────────────────────────────────────────────────────────

model Contact {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String?
  lastName  String?
  phone     String?
  phone2    String?
  email2    String?
  company   String?
  source    String?  // "signup", "import", "subscribe", "application"
  lastActivity   String?
  lastActivityAt DateTime?
  userId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses        ContactAddress[]
  consents         ContactConsent[]
  tags             ContactTag[]
  notes            ContactNote[]
  listMemberships  ContactListMember[]
  campaignSends    CampaignSend[]
  subscriptions     ContactSubscription[]
  attribution       ContactAttribution?
  customFieldValues CustomFieldValue[]
  activities        ContactActivity[]
  identities        ContactIdentity[]

  @@index([email])
  @@index([userId])
}

model ContactAddress {
  id        String   @id @default(cuid())
  contactId String
  type      String?
  street    String?
  street2   String?
  city      String?
  state     String?
  zip       String?
  country   String?
  isPrimary Boolean  @default(true)
  updatedAt DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model ContactConsent {
  id         String              @id @default(cuid())
  contactId  String
  topic      ContactConsentTopic
  optedIn    Boolean             @default(true)
  optedInAt  DateTime?
  optedOutAt DateTime?
  source     String?             // "signup", "import", "unsubscribe-link", "admin"
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, topic])
