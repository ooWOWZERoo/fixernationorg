# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (preferred) — obtain from Hosting.com cPanel or a managed provider
DATABASE_URL="postgresql://user:password@localhost:5432/fixernation?schema=public"
# MySQL/MariaDB fallback (if PostgreSQL is unavailable on cPanel):
# DATABASE_URL="mysql://user:password@localhost:3306/fixernation"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_-base64_32
AUTH_URL=http://localhost:3000

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Postmark ─────────────────────────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_FROM_ADDRESS=noreply@fixernation.org
POSTMARK_FROM_NAME=Fixer Nation

# ─── PostHog (analytics — consent-gated) ─────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=fixernation-org
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Secret token cPanel includes when calling /api/cron?token=X
CRON_SECRET=CHANGE_ME_generate_with_openssl_rand_-base64_32

# ─── Design System Preview ────────────────────────────────────────────────────
# Password to access the /design preview route
DESIGN_PREVIEW_PASSWORD=CHANGE_ME
